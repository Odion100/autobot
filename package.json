{
  "name": "autobot",
  "type": "module",
  "version": "1.0.0",
  "engines": {
    "node": ">=22"
  },
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "hub": "node systemview/service.js",
    "prestart": "node -e \"if(+process.versions.node.split('.')[0]<22){console.error('\\nautobot needs node >= 22 \u2014 run: nvm use 22\\n');process.exit(1)}\" && npm run ui:build",
    "start": "node electron/launch.js",
    "shell": "node electron/launch.js",
    "dev": "node electron/dev.js",
    "smoke:ax": "node common/driver/ax-smoke.js",
    "smoke:electron": "node electron/smoke.js",
    "smoke:terminal": "AUTOBOT_SHELL_SHOW=0 AUTOBOT_TERMSMOKE=1 node electron/launch.js",
    "ui:dev": "vite electron/ui",
    "ui:build": "vite build electron/ui",
    "smoke:agent": "AUTOBOT_SHELL_SHOW=0 AUTOBOT_AGENTSMOKE=1 node electron/launch.js",
    "smoke:status": "node tests/status-bound.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Odion100/autobot.git"
  },
  "author": "odion edwards",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Odion100/autobot/issues"
  },
  "homepage": "https://github.com/Odion100/autobot#readme",
  "dependencies": {
    "@langchain/community": "^0.0.35",
    "@langchain/openai": "^0.0.18",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@playwright/mcp": "^0.0.79",
    "agentci": "^0.5.1",
    "cheerio": "^1.0.0-rc.12",
    "chromadb": "^1.8.1",
    "dotenv": "^16.4.5",
    "langchain": "^0.1.25",
    "mongoose": "^8.6.1",
    "openai": "^4.28.4",
    "puppeteer": "^19.11.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "readline": "^1.3.0"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.241",
    "@vitejs/plugin-react": "^6.1.0",
    "cz-conventional-changelog": "^3.3.0",
    "electron": "^43.4.1",
    "marked": "^18.0.10",
    "nodemon": "^3.1.14",
    "systemlynx": "^3.3.2",
    "systemview-plugin": "^2.23.0",
    "vite": "^8.2.2"
  }
}
